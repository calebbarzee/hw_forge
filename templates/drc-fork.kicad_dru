(version 1)
# fork-only rules. stock 10.0.5 drops this whole file silently: run the probe first.
# a "#" comment must sit on its own line. PARAM marks a value to set per project.

# pad-centre distance, power pad A to nearest same-net cap pad B. 3 mm: fork rule
# library policy, no standard (hexpad as built 1.825 mm). PARAM: VDD pad numbers.
(rule "ic_decoupling"
	(constraint decoupling_distance (max 3mm))
	(condition "A.Reference == 'U*' && A.Pad_Number == '8' && B.Reference == 'C*'"))
# A-only twin: fires when the net has no capacitor pad at all.
(rule "ic_has_decoupling"
	(constraint decoupling_distance (max 3mm))
	(condition "A.Reference == 'U*' && A.Pad_Number == '8'"))

# amps and C rise -> min width by IPC-2221A 6.2, stackup thickness (35 um default).
# 1.3 A, 10 C, outer: 0.4314 mm. PARAM: current from the power budget.
(rule "supply_current"
	(constraint current (min 1.3) (opt 10))
	(condition "A.NetName == 'VCC'"))

# no value. add "&& A.Net != B.Net" to allow same-net via-in-pad.
(rule "no_via_in_pad"
	(constraint via_under_smd)
	(condition "A.Type == 'Via' && B.Pad_Type == 'SMD'"))

# 3D bounding-box gap, same side. 0.2 mm: fork rule library policy.
(rule "bodies_apart"
	(constraint model_clearance (min 0.2mm)))
# box height above the mounting side. PARAM: enclosure air-gap ledger.
(rule "back_side_height"
	(constraint model_height (max 2mm))
	(condition "A.Layer == 'B.Cu'"))

# fill checks read fills as they stand: run DRC with --refill-zones.
(rule "no_islands"
	(constraint zone_islands (max 0))
	(condition "A.Type == 'Zone'"))
# keep min well above the zone min_thickness (hexpad 0.2 mm: 5 artefacts at 0.2, 0 at 0.15).
(rule "wide_channels"
	(constraint zone_min_channel (min 0.5mm))
	(condition "A.Type == 'Zone'"))

# connected same-net copper per pad layer, mm2. PARAM: datasheet thermal layout;
# disabled by its condition until a datasheet figure replaces 25.
(rule "regulator_tab_copper"
	(constraint thermal_copper (min 25))
	(condition "A.Reference == 'U_SET_ME' && A.Pad_Number == '2'"))

# courtyard to outline. 0.5 mm: fork rule library policy.
# the current fork binary reads the mating end from a board-frame field
# Mating_Direction (N, S, E, W). the fork's workstream C, not yet landed, moves
# it to the footprint property mating_direction (+x -x +y -y +z -z, footprint
# axes), the one kicad_geom.py --contract reads. until it lands, the contract is
# the check that sees the mating end.
# PARAM: enclosure wall and opening tolerance.
(rule "connectors_on_edge"
	(constraint connector_edge (max 0.5mm))
	(condition "A.Reference == 'J*' || A.Reference == 'USB*'"))

# no value. any copper on the reference layer counts, whatever its net.
(rule "fast_edges_have_reference"
	(constraint reference_copper)
	(condition "A.NetClass == 'USB' || A.NetName == 'LED_D*'"))
